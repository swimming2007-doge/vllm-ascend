quiet_para=""
if test x"$quiet" = xy; then
    quiet_para="--quiet "
fi
scriptargs="--$name_of_file""--\"$pwd_of_file\""" $quiet_para""$scriptargs"

if test x"$quiet" = xy -a x"$verbose" = xy; then
